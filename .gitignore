# Compiled output. Generated by `npm run build`, which `npm test` runs first.
out/

# Installed dependencies
node_modules/

# Running log of the UI/UX verification agent. Machine output, not project
# history, and kept apart from anything the project's own test runner writes.
test-results/ui-ux-tester.agent/

# A global ignore rule for dotfiles hides .gitattributes, and that file is the
# only thing pinning this repository to LF endings. Un-ignore it here, where a
# repository .gitignore outranks the global one, so a plain `git add` carries
# it and every clone gets the same line endings.
!.gitattributes

# Same story as .gitattributes above: the global excludes file hides every
# dotfile, and a bulk `git add` would pass over this one without a word. It has
# to reach the published root or GitHub Pages runs the site through Jekyll and
# drops anything whose path begins with an underscore.
!.nojekyll

# And the file that does the un-ignoring has to un-ignore itself. The global
# rules name this one three times over - a bare dotfile pattern and twice by
# name - so without this line a bulk `git add` passes over it and the clone
# ignores nothing: out/, node_modules/ and the agent's test-results folder all
# read as untracked there, however carefully they are named above.
!.gitignore
